# 1. CẤU HÌNH APP & MÚI GIỜ NGHIỆP VỤ
NODE_ENV=development
PORT=4000
TZ=Asia/Ho_Chi_Minh
FRONTEND_URL=http://localhost:5173

# 2. CƠ SỞ DỮ LIỆU MYSQL 8.4 LTS (PRISMA)
DB_PORT=3306
DB_ROOT_PASSWORD=RefujiRoot@2026
DB_NAME=refuji_db
DB_USER=refuji_user
DB_PASSWORD=RefujiPass@2026
DATABASE_URL="mysql://refuji_user:RefujiPass@2026@localhost:3306/refuji_db"

# 3. BẢO MẬT JWT & COOKIE
JWT_ACCESS_SECRET="refuji_access_secret_key_change_in_prod_min_32_chars"
JWT_REFRESH_SECRET="refuji_refresh_secret_key_change_in_prod_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# 4. BẢO VỆ DỮ LIỆU CÁ NHÂN (LUẬT BVDLCN 2025 & LUẬT CĂN CƯỚC 2023)
# Khóa AES-256-GCM bắt buộc 32 bytes (64 ký tự hex) để mã hóa id_card_encrypted
PII_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Khóa HMAC-SHA256 để băm id_card_hash chống trùng lặp căn cước
PII_HMAC_SECRET="refuji_citizen_id_hmac_secret_2026"

# 5. CỔNG THANH TOÁN VNPAY SANDBOX (TÁCH LUỒNG RETURN & IPN)
VNP_TMNCODE="YOUR_VNPAY_TMNCODE"
VNP_HASHSECRET="YOUR_VNPAY_HASH_SECRET"
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_RETURN_URL="http://localhost:5173/payment/vnpay-return"
VNP_IPN_URL="https://your-tunnel-domain.trycloudflare.com/api/payments/vnpay/ipn"

# 6. LƯU TRỮ ẢNH KIỂM ĐỊNH PRIVATE (CLOUDINARY / S3 / R2)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
SIGNED_URL_EXPIRES_SECONDS=900

# 7. SMTP GỬI EMAIL TỰ ĐỘNG (TRỎ VÀO MAILPIT LOCAL HOẶC GMAIL SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="ReFuji Camera Rental <no-reply@refuji.vn>"
