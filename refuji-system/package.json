{
  "name": "refuji-system",
  "private": true,
  "version": "1.0.0",
  "description": "REFUJI - Fujifilm Camera & Lens Rental Monorepo System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@refuji/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
